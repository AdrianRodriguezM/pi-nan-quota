  },
  "bugs": {
    "url": "https://github.com/AdrianRodriguezM/pi-nan-quota/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "nan",
    "nan-builders",
    "quota",
    "usage",
    "footer",
    "statusline",
    "llm"
  ],
  "engines": {
